.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# Sandbox runtime scripts (environment tooling, not project code)
/.zscripts/

# Agent tool-result caches (session artifacts, not project code)
/tool-results/

# Test artifacts
/playwright-report/
/test-results/
/blob-report/

# Isolated static-export build verification workspace (Phase 0)
/.build-verify/

# Generated E2E fixtures (large synthetic files, rebuilt deterministically
# by the spec setup from the seeded generator)
/e2e/fixtures/*.generated.gpx
